# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing — never commit these. The keystore lives on your machine and,
# base64-encoded, in the KEYSTORE_BASE64 GitHub secret. Losing it means no
# future build can update an installed Momentum.
**/key.properties
*.jks
*.keystore

__pycache__/
